# Import this snippet into the HTTPS API site. Engine.IO writes rejected
# WebSocket upgrades directly to the socket, bypassing response middleware.
(wiez_realtime_security) {
    @wiez_realtime path /socket.io /socket.io/*
    header @wiez_realtime {
        >Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
        >X-Frame-Options "DENY"
        >X-Content-Type-Options "nosniff"
        >Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        >Referrer-Policy "strict-origin-when-cross-origin"
        >X-Permitted-Cross-Domain-Policies "none"
        >Permissions-Policy "camera=(), microphone=(), geolocation=()"
        >Cache-Control "no-store"
        -X-Powered-By
    }
}
